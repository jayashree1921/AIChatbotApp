# Rename this file to .env and add your own key.
# Expo automatically inlines any variable prefixed with EXPO_PUBLIC_ into the app bundle.

# OpenAI (default provider used by this app)
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Optional: change the model used for chat completions
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
